# Example environment variables (do NOT commit real secrets).
# Copy this file to .env and fill with your real values locally.

# PayPal configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
PAYPAL_MODE=sandbox

# Flask
FLASK_DEBUG=false
# Copy this file to .env and fill in your values.
# Never share your .env file — it contains secret keys.

# Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: change the secret key Flask uses for sessions (any random string)
FLASK_SECRET_KEY=change-this-to-a-random-string

# Optional: change the port the onboarding form runs on (default is 5000)
PORT=5000

# Twilio WhatsApp
# Sandbox: whatsapp:+14155238886
# Production: whatsapp:+1XXXXXXXXXX (from Twilio → Messaging → WhatsApp senders)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Production webhook URL (set in Twilio): https://yonderly.online/api/supabase_example

# Optional: port for standalone WhatsApp webhook server (default is 5001)
WHATSAPP_PORT=5001

# PayPal Business (for Vercel — set these in Vercel Dashboard → Settings → Environment Variables)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_PLAN_ID=P-your_subscription_plan_id_here
PAYPAL_MODE=live
