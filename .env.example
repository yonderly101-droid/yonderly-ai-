# Example environment variables (do NOT commit real secrets).
# Copy this file to .env and fill with your real values locally.

# PayPal configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
PAYPAL_MODE=sandbox

# Flask
FLASK_DEBUG=false
# Copy this file to .env and fill in your values.
# Never share your .env file — it contains secret keys.

# Your Anthropic API key (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: change the secret key Flask uses for sessions (any random string)
FLASK_SECRET_KEY=change-this-to-a-random-string

# Optional: change the port the onboarding form runs on (default is 5000)
PORT=5000

# Gmail OAuth (cloud email agent — set on Vercel)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
APP_URL=https://yonderly.online
CRON_SECRET=generate-a-long-random-string
GMAIL_OAUTH_SECRET=optional-separate-secret-for-oauth-state

WHATSAPP_VERIFY_TOKEN=choose-any-secret-string-you-set-in-meta
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta_api_setup
META_APP_ID=your_meta_app_id
WHATSAPP_EMBEDDED_CONFIG_ID=your_embedded_signup_configuration_id

# Supabase Auth (accounts + subscriptions + business profiles)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Set to true in production when PayPal subscriptions are live
REQUIRE_SUBSCRIPTION=false
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_MODE=sandbox

# Pabbly Connect (optional)
# Your Pabbly webhook listener (optional — logs/forwards AI replies):
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/webhook-listener/webhook/YOUR_ID/YOUR_ID
# Optional shared secret for POST /api/pabbly (header: X-Pabbly-Secret)
PABBLY_WEBHOOK_SECRET=
# Yonderly AI reply URL for Pabbly HTTP step: https://yonderly.online/pabbly/reply

# Optional: port for standalone WhatsApp webhook server (default is 5001)
WHATSAPP_PORT=5001

# PayPal Business (for Vercel — set these in Vercel Dashboard → Settings → Environment Variables)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_PLAN_ID=P-your_subscription_plan_id_here
PAYPAL_MODE=live
