{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.yonderly.online" }],
      "destination": "https://yonderly.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/pabbly/reply", "destination": "/api/pabbly" },
    { "source": "/webhook", "destination": "/api/whatsapp" },
    { "source": "/whatsapp", "destination": "/api/whatsapp" },
    { "source": "/api/account/me", "destination": "/api/account/me" },
    { "source": "/api/account/profile", "destination": "/api/account/profile" },
    { "source": "/api/subscription/activate", "destination": "/api/subscription/activate" },
    { "source": "/api/gmail/connect", "destination": "/api/gmail" },
    { "source": "/api/gmail/callback", "destination": "/api/gmail" },
    { "source": "/api/gmail/status", "destination": "/api/gmail" },
    { "source": "/api/gmail/disconnect", "destination": "/api/gmail" },
    { "source": "/api/cron/email-poll", "destination": "/api/cron/email-poll" },
    { "source": "/api/whatsapp/config", "destination": "/api/whatsapp-account" },
    { "source": "/api/whatsapp/complete", "destination": "/api/whatsapp-account" },
    { "source": "/api/whatsapp/status", "destination": "/api/whatsapp-account" },
    { "source": "/api/whatsapp/disconnect", "destination": "/api/whatsapp-account" }
  ]
}
