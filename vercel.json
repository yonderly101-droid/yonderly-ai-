{
  "version": 2,
  "builds": [
    { "src": "static/**", "use": "@vercel/static" },
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/static/index.html" },
    { "src": "^/index.html$", "dest": "/static/index.html" },
    { "src": "^/(.*)$", "dest": "/static/index.html" }
  ]
}
